GOOGLE_API_KEY=여기에_AI_Studio_키_입력
EMBEDDING_MODEL=models/text-embedding-004
LLM_MODEL=gemini-2.5-flash
CHROMA_PERSIST_DIR=./chroma_db
# (선택) 예전 단일 컬렉션 이름을 고객 풀으로 쓰려면 설정. 비우면 CHROMA_COLLECTION_CUSTOMER 사용
# CHROMA_COLLECTION=table_schemas
CHROMA_COLLECTION_CUSTOMER=table_schemas_customer
CHROMA_COLLECTION_ADMIN=table_schemas_admin
TOP_K_RESULTS=5
MAX_TOKENS_CONTEXT=6000
# 관리자 탭·업로드·Oracle SQL API (비우면 관리자 기능 비활성)
ADMIN_PASSWORD=
# (선택) 관리자 토큰 서명 전용 비밀. 비우면 ADMIN_PASSWORD로 서명
ADMIN_JWT_SECRET=
# 풀별 테이블명(파일명) 검사: 고객 TBL_*, 관리자 TB_*
TABLE_NAME_POOL_VALIDATION=true
# TABLE_NAME_REGEX_CUSTOMER=^TBL_[A-Z0-9]+$
# TABLE_NAME_REGEX_ADMIN=^TB_[A-Z0-9]+$
# OpenAI (HFSR→DNA 컬럼 매핑 전용). 비우면 편집거리 유사도만 사용
OPENAI_API_KEY=
OPENAI_MAPPING_MODEL=gpt-4o
